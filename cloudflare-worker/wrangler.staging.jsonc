{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "acolhetest-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat"],
  // Scheduled maintenance is paused in staging to prevent background quota
  // consumption during development and validation.
  "vars": {
    "FRONTEND_URL": "https://acolhetest-staging.luccasuper1.workers.dev",
    "APP_ENV": "staging",
    "SCHEDULED_MAINTENANCE_ENABLED": "false"
  },
  "assets": {
    "directory": "../frontend/build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "MONGO_GATEWAY", "class_name": "MongoGateway" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MongoGateway"] }
  ]
}
